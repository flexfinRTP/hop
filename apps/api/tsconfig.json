{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@hop/shared": ["../../packages/shared/src/index.ts"]
    }
  },
  "files": ["src/index.ts"],
  "include": ["src/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "../../cre",
    "../../apps/web",
    "../../apps/mcp",
    "../../apps/harness"
  ]
}
