# Hop API (copy to .env — never commit .env)

PORT=8787

# Blocky402 facilitator (Hedera exact). Do not proxy Graph Base USDC x402.
BLOCKY402_FACILITATOR_URL=https://api.testnet.blocky402.com

# Merchant receive account (Hedera testnet). extra.feePayer is NOT this value —
# it MUST be copied from GET {BLOCKY402_FACILITATOR_URL}/supported at request time.
HEDERA_NETWORK=hedera:testnet
HEDERA_ASSET=0.0.0
HEDERA_PAY_TO=
HOP_PRICE_TINYBARS=100000

# Live Messari lending 3.1.0 subgraphs — fill only after verifying deployments exist.
# Intended pair: Aave v3 + Compound v3 on a chain The Graph still serves.
# Do not hardcode dead IDs. Document id + schemaVersion in evidence when wired.
GRAPH_PROTOCOL_A_ID=
GRAPH_PROTOCOL_A_URL=
GRAPH_PROTOCOL_B_ID=
GRAPH_PROTOCOL_B_URL=

# Rate limit / faucet drain
PAYER_ALLOWLIST=
QUERY_RATE_LIMIT_PER_MIN=6
