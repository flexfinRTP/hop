# Hop API (copy to .env — never commit .env)
# Fast path: npm run setup:local   then fund the printed EVM addresses
#            npm run setup:accounts
#            paste GRAPH_API_KEY from https://thegraph.com/studio/apikeys/

PORT=8787

BLOCKY402_FACILITATOR_URL=https://api.testnet.blocky402.com
HEDERA_NETWORK=hedera:testnet
HEDERA_ASSET=0.0.0
HEDERA_PAY_TO=
HOP_PRICE_TINYBARS=100000

# Pinned Messari 3.1.0 (override URL after verifying the gateway accepts your key)
GRAPH_API_KEY=
GRAPH_GATEWAY=https://gateway.thegraph.com/api/subgraphs/id
GRAPH_PROTOCOL_A_ID=JCNWRypm7FYwV8fx5HhzZPSFaMxgkPuw4TnR3Gpi81zk
GRAPH_PROTOCOL_A_URL=
GRAPH_PROTOCOL_B_ID=AwoxEZbiWLvv6e3QdvdMZw4WDURdGbvPfHmZRc8Dpfz9
GRAPH_PROTOCOL_B_URL=
CHAIN_RPC_URL=https://ethereum-rpc.publicnode.com

HOP_POLICY_TABLE_JSON={"version":"week-1","k":5,"caps":[{"metric":"utilization","op":"gt","value":0.78,"scope":"all"}]}

PAYER_ALLOWLIST=
QUERY_RATE_LIMIT_PER_MIN=6

# inline = same join in-process (dev only). Default cre = CRE CLI HTTP trigger (live Graph inside handlerInTee).
HOP_JOIN=cre
CRE_CWD=
# Executable name or absolute path visible to the API process. Windows example: C:\tools\cre.exe
CRE_CLI=cre
# Simulator / HTTP-trigger signer (64 hex, no 0x). Same key as cre/.env CRE_ETH_PRIVATE_KEY.
CRE_ETH_PRIVATE_KEY=
# Live DON (invite). When set, paid hop also POSTs workflows.execute to CRE_GATEWAY_URL.
CRE_WORKFLOW_ID=
CRE_GATEWAY_URL=https://01.enterprise-gateway.zone-a.cre.chain.link/

# Workbench 402 retry signer (real Blocky402 payload). 1 = enable POST /v1/demo/sign
HOP_DEMO_SIGN=0
HEDERA_DEMO_ACCOUNT_ID=
HEDERA_DEMO_PRIVATE_KEY=

HEDERA_HCS_TOPIC=
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=

HOP_CORS_ORIGIN=http://localhost:5173
WALL_BUFFER=0.2
HOP_EVIDENCE_DIR=
HOP_EVIDENCE_TTL_MS=259200000
HOP_API_URL=http://localhost:8787

# Agent mandate (deterministic; LLM never pays). Empty pay_to binds to HEDERA_PAY_TO.
HOP_MANDATE_JSON={"id":"desk-1","agent_id":"workbench","max_tinybars":5000000,"max_hops":40,"window_s":3600,"expires_at":"2027-01-01T00:00:00Z","pay_to":"","queries":["policy_check","market_params","position_counts","liquidations","account_ltv"],"max_block_lag":500,"human_threshold_tinybars":0}
HOP_MANDATE_REQUIRED=0

# Meter from public metrics only (protocol count; optional cached utilization). Never the secret cap.
HOP_METER_TINYBARS=10000
HOP_METER_UTIL_TINYBARS=0

# 1 = create a testnet HCS topic on first paid hop if HEDERA_HCS_TOPIC is empty
HOP_HCS_AUTO=1

# World ID 4.0 (optional). From developer.world.org. WORLD_REQUIRED=1 gates paid hops.
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_RP_SIGNING_KEY=
WORLD_ACTION=hop-query
WORLD_ENVIRONMENT=staging
WORLD_REQUIRED=0

