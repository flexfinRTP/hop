# Simulator key (64 hex chars, no 0x). Required even if this workflow does not write chain.
CRE_ETH_PRIVATE_KEY=

# Week-1 policy table JSON. Non-empty required. Never commit .env.
# Do not put the cap values in evidence responses — handler returns threshold hash only.
HOP_POLICY_TABLE_JSON={"version":"week-1","caps":[{"metric":"utilization","protocol":"aave-v3","cap":"SET_LOCALLY"}]}
