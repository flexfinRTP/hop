# Simulator key (64 hex chars, no 0x). Required even if this workflow does not write chain.
CRE_ETH_PRIVATE_KEY=

# Week-1 policy table JSON. Non-empty required. Never commit .env.
# Caps never leave the handler — evidence stores threshold hash only.
HOP_POLICY_TABLE_JSON={"version":"week-1","k":5,"caps":[{"metric":"utilization","op":"gt","value":0.78,"scope":"all"}]}

# Optional. Used as Authorization: Bearer on Graph gateway requests from inside handlerInTee.
GRAPH_API_KEY=

# Official Sepolia challenge (CRE Vault / simulate --broadcast)
LIQUIDATION_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
LIQUIDATION_EXECUTOR_PRIVATE_KEY=
LIQUIDATION_MIN_HF_TRIGGER=105
LIQUIDATION_TARGET_HF=120
LIQUIDATION_MAX_REPAY_PCT=25
LIQUIDATION_MAX_DEPOSIT_UNITS=200
LIQUIDATION_ACTION_PRIORITY=repay-first
LIQUIDATION_SAFETY_MARGIN=2
LIQUIDATION_COOLDOWN_SECONDS=60
LIQUIDATION_EMERGENCY_HF=100
LIQUIDATION_COMMITMENT_SALT=
